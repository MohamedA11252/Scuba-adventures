---
import MainLayout from '../../layouts/MainLayout.astro';
import Card from '../../components/ui/Card.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import { BRAND_WHATSAPP_1, BRAND_WHATSAPP_2 } from '../../lib/brand';
import { getLangFromPathname, getTranslations } from '../../lib/i18n';
import { dbRun } from '../../db/client';
import { randomUUID } from 'crypto';

const lang = getLangFromPathname(Astro.url.pathname);
const t = getTranslations(lang);

let sent = Astro.url.searchParams.get('sent') === '1';
let errorMessage: string | null = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = String(formData.get('name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const message = String(formData.get('message') ?? '').trim();

    if (!name || !email || !message) {
      errorMessage = 'Please fill in all fields.';
    } else if (!/\S+@\S+\.\S+/.test(email)) {
      errorMessage = 'Please provide a valid email address.';
    } else {
      await dbRun('INSERT INTO contact_messages (id, name, email, message, created_at) VALUES (?, ?, ?, ?, ?)', [randomUUID(), name, email, message, Date.now()]);
      return Astro.redirect(`/${lang}/contact?sent=1`);
    }
  } catch (err) {
    console.error('Contact form error:', err);
    errorMessage = 'An unexpected error occurred. Please try again later.';
  }
}
---

<MainLayout title={t.contact.title} description={t.contact.description}>
  <section class="pt-24 sm:pt-28 pb-12 sm:pb-16 bg-background" data-animate="fade-up">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-12">
        <h1 class="text-2xl sm:text-4xl font-bold" data-i18n-key="contact.heading">{t.contact.heading}</h1>
        <p class="text-base sm:text-lg text-text-secondary mt-3" data-i18n-key="contact.subtitle">{t.contact.subtitle}</p>
      </div>

      {sent && (
        <div class="max-w-3xl mx-auto mb-6">
          <div class="rounded-md bg-green-50 border border-green-200 p-4 text-green-800">Thanks — your message was sent. We'll get back to you within 24 hours.</div>
        </div>
      )}

      {errorMessage && (
        <div class="max-w-3xl mx-auto mb-6">
          <div class="rounded-md bg-red-50 border border-red-200 p-4 text-red-800">{errorMessage}</div>
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <Card>
          <h2 class="text-xl sm:text-2xl font-semibold mb-4" data-i18n-key="contact.speakTitle">{t.contact.speakTitle}</h2>
          <p class="text-text-secondary break-all" data-i18n-key="common.whatsapp">{t.common.whatsapp}: {BRAND_WHATSAPP_1}</p>
          <p class="text-text-secondary break-all" data-i18n-key="common.whatsapp">{t.common.whatsapp}: {BRAND_WHATSAPP_2}</p>
          <p class="text-text-secondary mt-4" data-i18n-key="contact.location">{t.contact.location}</p>
        </Card>
        <Card>
          <h2 class="text-xl sm:text-2xl font-semibold mb-4" data-i18n-key="contact.sendTitle">{t.contact.sendTitle}</h2>
          <form id="contact-form" method="POST" class="space-y-4">
            <div>
              <label for="name" class="text-sm text-text-secondary" data-i18n-key="contact.name">{t.contact.name}</label>
              <Input id="name" name="name" placeholder={t.contact.namePlaceholder} data-i18n-key="contact.namePlaceholder" />
            </div>
            <div>
              <label for="email" class="text-sm text-text-secondary" data-i18n-key="auth.email">{t.auth.email}</label>
              <Input id="email" name="email" type="email" placeholder={t.auth.emailPlaceholder} data-i18n-key="auth.emailPlaceholder" />
            </div>
            <div>
              <label for="message" class="text-sm text-text-secondary" data-i18n-key="contact.message">{t.contact.message}</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-secondary focus:border-secondary transition-colors"></textarea>
            </div>
            <Button type="submit" class="w-full" data-i18n-key="contact.send">{t.contact.send}</Button>
          </form>
        </Card>
      </div>
    </div>
  </section>
</MainLayout>

<script is:inline>
  const form = document.getElementById('contact-form');
  
  if (form) {
    form.addEventListener('submit', function(e) {
      // Allow natural form submission to work with server-side POST handler
      // No need to preventDefault - let the form post naturally to the server
    });
  }
</script>
