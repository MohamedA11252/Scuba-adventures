---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { dbAll } from '../../db/client';
import { lucia } from '../../lib/auth';

let comments: any[] = [];
let errorMessage = '';

const { user, session } = await lucia.validateSession(Astro.cookies.get(lucia.sessionCookieName)?.value ?? "");
const isAdmin = user?.role === 'ADMIN';

// Fetch all comments from database
try {
    comments = await dbAll('SELECT * FROM comments ORDER BY created_at DESC LIMIT 100');
} catch (error) {
    console.error("Error fetching comments:", error);
    errorMessage = 'Failed to load comments. Please try again later.';
    comments = [];
}
---

<Layout title="All Guest Comments | Scuba Adventures">
  <main class="max-w-4xl mx-auto my-12 p-6 bg-slate-900 rounded-xl shadow-2xl text-white border border-slate-800">
    
    <h1 class="text-3xl md:text-4xl font-bold mb-2 text-center" style="color: #ecca0ad2; font-family: inherit;">
      Guest Comments
    </h1>
    <p class="text-center text-slate-400 mb-8">What our guests are saying about their experience</p>
    
    {errorMessage && (
      <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-lg mb-8">
        {errorMessage}
      </div>
    )}

    <div id="comment-toast" class="hidden mb-4 px-4 py-2 rounded-lg text-sm font-medium"></div>

    <!-- Comments Display Section -->
    <section class="comments-display-section">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-semibold text-slate-300">
          All Comments ({comments.length})
        </h2>
        <a 
          href="/en/guest-comments" 
          class="px-4 py-2 bg-yellow-600 hover:bg-yellow-500 text-slate-950 font-semibold rounded-lg transition-all"
        >
          Leave a Comment
        </a>
      </div>
      
      {comments.length > 0 ? (
        <div class="space-y-6">
          {comments.map((comment: any) => (
            <div class="bg-slate-800 border border-slate-700 rounded-lg p-6 hover:border-slate-600 transition-all comment-card" data-comment-id={comment.id}>
              <!-- Comment Header -->
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="font-semibold text-white text-lg">{comment.author}</h3>
                  <p class="text-sm text-slate-400 capitalize">{comment.level.replace('-', ' ')}</p>
                </div>
                <div class="flex items-center gap-2">
                  <div class="text-yellow-500 text-xl">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span key={i} style={`color: ${i < comment.rating ? '#ecca0ad2' : '#4b5563'}`}>
                        ★
                      </span>
                    ))}
                  </div>
                  <span class="text-slate-400 text-sm bg-slate-700 px-2 py-1 rounded">{comment.rating}/5</span>
                </div>
              </div>
              
              <!-- Comment Content -->
              <p class="text-slate-300 mb-4 leading-relaxed text-base">{comment.content}</p>
              
              <!-- Comment Footer -->
              <div class="flex items-center justify-between">
                <p class="text-xs text-slate-500">
                  {new Date(comment.created_at).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  })}
                </p>
                {isAdmin && (
                  <div class="flex items-center gap-2">
                    {comment.featured === 1 && (
                      <span class="text-xs text-yellow-500 font-medium bg-yellow-500/10 px-2 py-1 rounded">Featured</span>
                    )}
                    <button
                      type="button"
                      class="feature-btn flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium transition-all"
                      data-comment-id={comment.id}
                      data-featured={comment.featured ? '1' : '0'}
                    >
                      <span class="text-base">★</span>
                      <span class="feature-label">{comment.featured ? 'Unfeature' : 'Feature'}</span>
                    </button>
                    <button
                      type="button"
                      class="delete-btn flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-red-500/10 text-red-400 hover:bg-red-500/20"
                      data-comment-id={comment.id}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      <span>Delete</span>
                    </button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-slate-400 text-lg mb-4">No comments yet.</p>
          <a 
            href="/en/guest-comments" 
            class="inline-block px-6 py-3 bg-yellow-600 hover:bg-yellow-500 text-slate-950 font-bold rounded-lg transition-all"
          >
            Be the first to share your experience!
          </a>
        </div>
      )}
    </section>

    <!-- Back to Home -->
    <div class="mt-12 text-center">
      <a 
        href="/en" 
        class="text-slate-400 hover:text-yellow-500 transition-colors underline"
      >
        ← Back to Home
      </a>
    </div>
  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
  .feature-btn {
    background: rgba(236, 202, 10, 0.1);
    color: #ecca0ad2;
  }
  .feature-btn:hover {
    background: rgba(236, 202, 10, 0.2);
  }
  .feature-btn[data-featured="1"] {
    background: rgba(236, 202, 10, 0.2);
    color: #ecca0ad2;
  }
</style>

{isAdmin && (
  <script is:inline>
    const toast = document.getElementById('comment-toast');

    const showToast = (msg, ok = true) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('hidden', 'bg-red-500/10', 'text-red-400', 'bg-green-500/10', 'text-green-400');
      toast.classList.add(ok ? 'bg-green-500/10' : 'bg-red-500/10', ok ? 'text-green-400' : 'text-red-400');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    };

    document.querySelectorAll('.feature-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const commentId = btn.getAttribute('data-comment-id');
        try {
          const res = await fetch('/api/comments/manage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'toggle-feature', commentId })
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            const label = btn.querySelector('.feature-label');
            const card = btn.closest('.comment-card');
            const featuredSpan = card?.querySelector('.text-yellow-500.font-medium');
            if (data.featured) {
              btn.setAttribute('data-featured', '1');
              if (label) label.textContent = 'Unfeature';
              if (!featuredSpan) {
                const span = document.createElement('span');
                span.className = 'text-xs text-yellow-500 font-medium bg-yellow-500/10 px-2 py-1 rounded';
                span.textContent = 'Featured';
                btn.parentElement?.insertBefore(span, btn);
              }
            } else {
              btn.setAttribute('data-featured', '0');
              if (label) label.textContent = 'Feature';
              featuredSpan?.remove();
            }
            showToast(data.featured ? 'Comment featured' : 'Comment unfeatured');
          } else {
            showToast(data.error || 'Action failed', false);
          }
        } catch (err) {
          showToast('Network error', false);
        }
      });
    });

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this comment? This cannot be undone.')) return;
        const commentId = btn.getAttribute('data-comment-id');
        try {
          const res = await fetch('/api/comments/manage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', commentId })
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            const card = btn.closest('.comment-card');
            card?.remove();
            const countEl = document.querySelector('.comments-display-section h2');
            const remaining = document.querySelectorAll('.comment-card').length;
            if (countEl) countEl.textContent = `All Comments (${remaining})`;
            showToast('Comment deleted');
            if (remaining === 0) location.reload();
          } else {
            showToast(data.error || 'Delete failed', false);
          }
        } catch (err) {
          showToast('Network error', false);
        }
      });
    });
  </script>
)}
