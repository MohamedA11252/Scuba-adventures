---
interface Props {
  price: string | number;
  priceLabel?: string;
  productName?: string;
  currency?: string;
  itemId?: string;
  itemType?: "course" | "trip" | "specialty" | "adventure"; // تم إضافة adventure هنا
}

const { 
  price, 
  priceLabel = "Book Now",
  productName = "Scuba Adventure", 
  currency = "EUR",
  itemId = "default",
  itemType = "course"
} = Astro.props;

// Normalize price for PayPal (accepts strings like "€1000", "1.000,00", "1,000.00", "1000€")
let numPrice: number;
if (typeof price === 'string') {
  // keep only digits, dot, comma and minus sign
  const cleaned = price.replace(/[^0-9.,-]/g, '');

  if (cleaned === '' || cleaned === '-' || cleaned === ',') {
    numPrice = 0;
  } else {
    // If both dot and comma exist, decide which is thousand separator and which is decimal
    if (cleaned.indexOf('.') > -1 && cleaned.indexOf(',') > -1) {
      // If dot comes before comma, treat dot as thousand separator: "1.234,56" -> "1234.56"
      if (cleaned.indexOf('.') < cleaned.indexOf(',')) {
        numPrice = parseFloat(cleaned.replace(/\./g, '').replace(',', '.'));
      } else {
        // comma comes before dot: "1,234.56" -> remove commas
        numPrice = parseFloat(cleaned.replace(/,/g, ''));
      }
    } else {
      // Only one of dot/comma exists or none
      const normalized = cleaned.replace(/,/g, '.');
      numPrice = parseFloat(normalized);
    }

    if (!isFinite(numPrice)) numPrice = 0;
  }
} else {
  numPrice = Number(price) || 0;
}

const formattedPrice = numPrice.toFixed(2);
---

<div class="paypal-button-wrapper">
  <button 
    id={`btn-${itemId}`}
    class="pp-book-now-btn inline-flex items-center justify-center rounded-md font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-opacity-90 ring-primary px-4 py-2 text-sm w-full"
  >
    {priceLabel}
  </button>
</div>

<script define:vars={{ itemId, formattedPrice, currency, productName, itemType }}>
  const button = document.getElementById(`btn-${itemId}`);
  if (button) {
    button.addEventListener("click", (e) => {
      e.preventDefault();
      
      // Redirect to PayPal checkout with price in URL
      const paypalCheckoutUrl = `/checkout?price=${formattedPrice}&currency=${currency}&product=${encodeURIComponent(productName)}&itemId=${itemId}&itemType=${itemType}`;
      
      window.location.href = paypalCheckoutUrl;
    });
  }
</script>

<style>
  .pp-book-now-btn {
    background: linear-gradient(135deg, #0070ba 0%, #003087 100%);
    border: none;
    box-shadow: 0 2px 8px rgba(0, 112, 186, 0.3);
    min-height: 44px;
  }

  .pp-book-now-btn:hover {
    background: linear-gradient(135deg, #005ea6 0%, #002875 100%);
    box-shadow: 0 4px 12px rgba(0, 112, 186, 0.5);
  }

  .pp-book-now-btn:active {
    transform: scale(0.98);
  }
</style>
